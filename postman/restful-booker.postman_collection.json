        {
          "name": "Get Booking IDs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "/*Positive Test Cases*/\r",
                  "pm.test(\"Status code: Code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"response is an array\", function () {\r",
                  "    const responseJson = pm.response.json();\r",
                  "    pm.expect(responseJson).to.be.an('array');\r",
                  "});\r",
                  "\r",
                  "pm.test(\"each item has a bookingid\", function () {\r",
                  "    const responseJson = pm.response.json();\r",
                  "    responseJson.forEach(item => {\r",
                  "        pm.expect(item).to.have.property('bookingid');\r",
                  "        pm.expect(item.bookingid).to.be.a('number');\r",
                  "    });\r",
                  "});\r",
                  "\r",
                  "pm.test(\"firstname filter returns matching results\", function () {\r",
                  "    const responseJson = pm.response.json();\r",
