                  "});",
                  "",
                  "pm.test(\"Last name is correct\", function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.lastname).to.eql(pm.collectionVariables.get(\"lastname\"));",
                  "});",
                  "",
                  "pm.test(\"Deposit paid is correct\", function() {",
                  "    const response = pm.response.json();",
