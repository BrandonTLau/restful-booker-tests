          "name": "Get Booking",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "/*Positive Test Cases*/",
                  "pm.test(\"Status code: Code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Schema is valid\", function () {",
                  "    const schema = {",
                  "        type: \"object\",",
                  "        properties: {",
                  "            firstname: { type: \"string\" },",
                  "            lastname: { type: \"string\" },",
                  "            totalprice: { type: \"number\" },",
                  "            depositpaid: { type: \"boolean\" },",
                  "            bookingdates: {",
                  "                type: \"object\",",
                  "                properties: {",
                  "                    checkin: { type: \"string\" },",
                  "                    checkout: { type: \"string\" }",
                  "                },",
                  "                required: [\"checkin\", \"checkout\"]",
                  "            },",
                  "            additionalneeds: { type: \"string\" }",
                  "        },",
                  "        required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"]",
                  "    };",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test(\"firstname matches expected\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.firstname).to.eql(pm.collectionVariables.get(\"firstname\"));",
                  "});",
                  "",
                  "pm.test(\"all booking fields match expected\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.lastname).to.eql(pm.collectionVariables.get(\"lastname\"));",
                  "    pm.expect(responseJson.depositpaid).to.eql(pm.collectionVariables.get(\"depositpaid\") === \"true\");",
                  "    pm.expect(responseJson.bookingdates.checkin).to.eql(pm.collectionVariables.get(\"checkin\"));",
                  "    pm.expect(responseJson.bookingdates.checkout).to.eql(pm.collectionVariables.get(\"checkout\"));",
                  "});",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
