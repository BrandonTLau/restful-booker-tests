        {
          "name": "Create Booking",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('firstname', pm.variables.replaceIn('{{$randomFirstName}}'));\r",
                  "\r",
                  "pm.collectionVariables.set('lastname', pm.variables.replaceIn('{{$randomLastName}}'));\r",
                  "\r",
                  "pm.collectionVariables.set('totalprice', pm.variables.replaceIn('{{$randomPrice}}'));\r",
                  "\r",
                  "pm.collectionVariables.set('depositpaid', pm.variables.replaceIn('{{$randomBoolean}}'));\r",
                  "\r",
                  "const rawDateRecent = pm.variables.replaceIn('{{$randomDateRecent}}');\r",
                  "const checkin = new Date(rawDateRecent).toISOString().split('T')[0]; // yyyy-mm-dd\r",
                  "pm.collectionVariables.set('checkin', checkin);\r",
                  "\r",
                  "const rawDateFuture = pm.variables.replaceIn('{{$randomDateFuture}}');\r",
                  "const checkout = new Date(rawDateFuture).toISOString().split('T')[0]; // yyyy-mm-dd\r",
                  "pm.collectionVariables.set('checkout', checkout);\r",
                  "\r",
                  "pm.collectionVariables.set('additionalneeds', pm.variables.replaceIn('{{$randomLoremSentence}}'));\r",
                  "\r",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "/*Positive Test Cases*/",
                  "pm.test(\"Status code: Code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Schema is valid\", function () {",
                  "    const schema = {",
                  "        type: \"object\",",
                  "        properties: {",
                  "            bookingid: { type: \"number\" },",
                  "            booking: {",
                  "                type: \"object\",",
                  "                properties: {",
                  "                    firstname: { type: \"string\" },",
                  "                    lastname: { type: \"string\" },",
                  "                    totalprice: { type: \"number\" },",
                  "                    depositpaid: { type: \"boolean\" },",
                  "                    bookingdates: {",
                  "                        type: \"object\",",
                  "                        properties: {",
                  "                            checkin: { type: \"string\" },",
                  "                            checkout: { type: \"string\" }",
                  "                        },",
                  "                        required: [\"checkin\", \"checkout\"]",
                  "                    },",
                  "                    additionalneeds: { type: \"string\" }",
                  "                },",
                  "                required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\"]",
                  "            }",
                  "        },",
                  "        required: [\"bookingid\", \"booking\"]",
                  "    };",
                  "",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test(\"bookingid is valid\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.bookingid).to.be.a('number');",
                  "    pm.expect(responseJson.bookingid).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"first name is correct\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.booking.firstname).to.eql(pm.collectionVariables.get(\"firstname\"));",
                  "});",
                  "",
                  "pm.test(\"last name is correct\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.booking.lastname).to.eql(pm.collectionVariables.get(\"lastname\"));",
                  "});",
                  "",
                  "pm.test(\"total price is correct - DEF-02: known bug, API truncates decimals\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    const expectedPrice = Math.trunc(Number(pm.collectionVariables.get(\"totalprice\")));",
                  "    pm.expect(responseJson.booking.totalprice).to.eql(expectedPrice);",
                  "});",
                  "",
                  "pm.test(\"content-type header is application/json - DEF-01 known issue\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\", \"application/json; charset=utf-8\");",
                  "});",
                  "",
                  "pm.test(\"deposit paid is consistent\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const expectedDeposit = pm.collectionVariables.get(\"depositpaid\") === \"true\";",
                  "    pm.expect(jsonData.booking.depositpaid).to.eql(expectedDeposit);",
                  "});",
                  "",
                  "pm.test(\"check in is correct\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.booking.bookingdates.checkin).to.eql(pm.collectionVariables.get(\"checkin\"));",
                  "});",
                  "",
                  "pm.test(\"check out is correct\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.booking.bookingdates.checkout).to.eql(pm.collectionVariables.get(\"checkout\"));",
                  "});",
                  "",
                  "pm.test(\"additional needs is correct\", function () {",
                  "    const responseJson = pm.response.json();",
                  "    pm.expect(responseJson.booking.additionalneeds).to.eql(pm.collectionVariables.get(\"additionalneeds\"));",
                  "});",
                  "",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
